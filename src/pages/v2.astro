---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/icons/Icon.astro";
import { Image } from "astro:assets";
import goblinTee from "../assets/merch-goblin-tee.webp";
import partnerLogo from "../assets/partner-foxnsons-logo.jpg";
import { getLatestEpisode } from "../lib/rss";

let latest = null;
try {
  latest = await getLatestEpisode();
} catch (err) {
  console.error("[obdm] Failed to fetch RSS feed at build time:", err);
}

function formatTime(seconds: number): string {
  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = Math.floor(seconds % 60);
  const mm = h > 0 ? String(m).padStart(2, "0") : String(m);
  const ss = String(s).padStart(2, "0");
  return h > 0 ? `${h}:${mm}:${ss}` : `${mm}:${ss}`;
}

const marqueeItems = [
  "UFOS", "BIGFOOT", "CONSPIRACIES", "ANCIENT CIVILIZATIONS", "CURRENT EVENTS",
  "THE PARANORMAL", "CALL 513·461·2175", "LIVE WED 7PM ET", "LIVE SAT 10:30AM ET",
];

const support = [
  { name: "SubscribeStar", href: "https://www.subscribestar.com/obdm", icon: "star" as const },
  { name: "Crypto / Tip Jar", href: "https://streamlabs.com/ourbigdumbmouth/tip", icon: "coin" as const },
];
---

<Layout
  title="OBDM Concept v2 — Kinetic Broadcast | Our Big Dumb Mouth"
  description="Design-direction concept for the OBDM site rebuild — a bolder, kinetic-brutalist take on the same content."
  episode={latest}
>
  <div class="concept-flag">
    <span>CONCEPT PREVIEW</span> — not final copy, art, or code. A second design direction to react to.
    <a href="/">← Back to v1</a>
  </div>

  <nav class="v2nav">
    <div class="wrap v2nav__inner">
      <a href="#top" class="v2nav__brand">OBDM</a>
      <div class="v2nav__right">
        <div class="v2nav__links">
          <a href="#live">Podcast</a>
          <a href="#merch">Shop</a>
          <a href="#latest">Latest</a>
        </div>
        <a href="#join" class="v2btn v2btn--green">Join</a>
      </div>
    </div>
  </nav>

  <div class="marquee marquee--a" aria-hidden="true">
    <div class="marquee__track">
      {[...marqueeItems, ...marqueeItems].map((m) => (
        <span>{m}</span>
      ))}
    </div>
  </div>

  <header class="v2hero reveal" id="top">
    <video class="v2hero__video" autoplay muted loop playsinline preload="auto" tabindex="-1" aria-hidden="true">
      <source src="/hero/obdm-hero-loop-2x.mp4" type="video/mp4" />
    </video>
    <div class="v2hero__scanlines" aria-hidden="true"></div>
    <div class="v2hero__flicker" aria-hidden="true"></div>
    <div class="v2hero__scrim" aria-hidden="true"></div>
    <div class="v2hero__text">
      <span class="v2tag">CH·88 — OBDM-TV</span>
      <h1>OBDM</h1>
      <p class="v2hero__full">OUR BIG DUMB MOUTH</p>
      <p class="v2hero__kicker">Welcome to another fun-filled podcast adventure... Hooray!</p>
      <p class="v2hero__lead">
        OBDM is a live podcast and talk show hosted by MidNight Mike and Joe, with listeners like
        you who call into the show to share their opinions on the topics we discuss — UFOs,
        Bigfoot, conspiracies, the paranormal, ancient civilizations, current events, and more.
      </p>
      <div class="v2hero__cta">
        <a href="https://www.twitch.tv/obdmpod" target="_blank" rel="noopener" class="v2btn v2btn--amber v2btn--lg" data-live-toggle>
          <span class="live-dot" aria-hidden="true"></span>
          <span data-live-label>Watch Live</span>
        </a>
        <span class="v2hero__alt">Also: <a href="https://rumble.com/user/obdm" target="_blank" rel="noopener">Rumble</a> · <a href="https://x.com/obdmpod" target="_blank" rel="noopener">X</a></span>
      </div>
    </div>
  </header>

  <ul class="v2social reveal">
    {[
      { name: "Rumble", href: "https://rumble.com/user/obdm", icon: "rumble" as const },
      { name: "Twitch", href: "https://www.twitch.tv/obdmpod", icon: "twitch" as const },
      { name: "YouTube", href: "https://www.youtube.com/@obdmpod", icon: "youtube" as const },
      { name: "Instagram", href: "https://www.instagram.com/obdmpod/", icon: "instagram" as const },
      { name: "X", href: "https://x.com/obdmpod", icon: "x" as const },
    ].map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener">
          <Icon name={l.icon} size={18} />
          {l.name}
        </a>
      </li>
    ))}
  </ul>

  <main>
    <section class="v2sec reveal" id="live">
      <h2 class="v2h2">Join Live</h2>
      <div class="v2slate">
        <div class="v2slate__cell v2slate__cell--green">
          <span class="v2lbl">Main Show</span>
          <span class="v2slate__day">Wednesday</span>
          <span class="v2slate__time">7:00 PM ET</span>
          <p>Strange news. Alex Jones clips of the week.</p>
        </div>
        <div class="v2slate__cell v2slate__cell--amber">
          <span class="v2lbl">Hangover Show</span>
          <span class="v2slate__day">Saturday</span>
          <span class="v2slate__time">10:30 AM ET</span>
          <p>Saturday funday.</p>
        </div>
        <div class="v2slate__cell v2slate__cell--dark">
          <span class="v2lbl"><Icon name="phone" size={14} /> Call the Hotline</span>
          <a class="v2slate__phone" href="tel:+15134612175">513·461·2175</a>
          <p>Call in during the live show; we usually up the phone on Saturdays.</p>
        </div>
      </div>

      <ul class="v2console reveal-stagger">
        <li><a href="https://rumble.com/user/obdm" target="_blank" rel="noopener"><Icon name="rumble" size={20} /><span>Rumble</span><small>Live stream</small></a></li>
        <li><a href="https://www.twitch.tv/obdmpod" target="_blank" rel="noopener"><Icon name="twitch" size={20} /><span>Twitch</span><small>Live call-in</small></a></li>
        <li><a href="https://www.youtube.com/@obdmpod" target="_blank" rel="noopener"><Icon name="youtube" size={20} /><span>YouTube</span><small>Video + clips</small></a></li>
        <li>
          <div class="v2chan v2chan--sub">
            <Icon name="podcast" size={20} /><span>Subscribe</span>
            <span class="v2chan__sub-links">
              <a href="https://open.spotify.com/show/7FNTBMeeIG0WFyySnl6Ix3" target="_blank" rel="noopener">Spotify</a>
              <a href="https://podcasts.apple.com/us/podcast/our-big-dumb-mouth/id261189509" target="_blank" rel="noopener">Apple</a>
            </span>
          </div>
        </li>
        <li><a href="https://ourbigdumbmouth.libsyn.com/rss" target="_blank" rel="noopener"><Icon name="rss" size={20} /><span>RSS</span><small>Own the feed</small></a></li>
      </ul>
    </section>

    <section class="v2sec v2sec--violet reveal" id="join">
      <h2 class="v2h2">Be a Part of the Magic</h2>

      <a class="v2discord" href="https://www.patreon.com/obdm" target="_blank" rel="noopener">
        <div class="v2discord__body">
          <span class="v2sticker">SUPPORT THE SHOW</span>
          <h3>Join the Discord</h3>
          <p>Connect with the OBDM community where the show never stops.</p>
          <span class="v2btn v2btn--dark">
            Unlock with Patreon for $1+/mo <Icon name="arrow-right" size={14} />
          </span>
        </div>
        <div class="v2discord__art" aria-hidden="true">
          <picture>
            <source srcset="/join/discord-saucer-still.webp" media="(prefers-reduced-motion: reduce)" />
            <img
              src="/join/discord-saucer.webp"
              alt=""
              width="520"
              height="456"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </a>

      <div class="v2support-row">
        <div class="v2card">
          <h4>Support the Show</h4>
          <p>Other ways to back the broadcast — no subscription required.</p>
          <div class="v2support-links">
            {support.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">
                <Icon name={s.icon} size={16} /> {s.name} <Icon name="arrow-right" size={14} />
              </a>
            ))}
          </div>
        </div>
        <div class="v2card">
          <h4>Keep in Touch</h4>
          <p>Maybe we'll do a newsletter. Or an emergency blast. Probably not. But maybe...</p>
          <form class="v2field" data-newsletter>
            <label for="v2-email" class="visually-hidden">Email address</label>
            <input id="v2-email" type="email" name="email" required placeholder="Enter your email address..." />
            <button type="submit" class="v2btn v2btn--white">Sign Up</button>
          </form>
        </div>
      </div>
    </section>

    <section class="v2sec v2sec--amber reveal" id="merch">
      <h2 class="v2h2">OBDM Shop</h2>
      <div class="v2merch reveal-stagger">
        <div class="v2merch__card">
          <div class="v2merch__art v2merch__art--photo">
            <Image src={goblinTee} alt="The Goblin OBDM tee" width={420} height={560} />
          </div>
          <span class="v2merch__name">The Goblin</span>
          <span class="v2merch__desc">Dark grey cotton, phosphor-green front print</span>
          <span class="v2merch__price">$28</span>
        </div>
        <div class="v2merch__card">
          <div class="v2merch__art"><Icon name="tumbler" size={64} /></div>
          <span class="v2merch__name">OBDM Tumbler</span>
          <span class="v2merch__desc">Stainless steel, keeps coffee hot and smoothies cold</span>
          <span class="v2merch__price">$32</span>
        </div>
        <div class="v2merch__card v2merch__card--partner">
          <span class="v2sticker v2sticker--sm">PARTNER SPOT</span>
          <div class="v2merch__art v2merch__art--photo">
            <Image src={partnerLogo} alt="Fox N' Sons Coffee" width={420} height={102} />
          </div>
          <span class="v2merch__desc">Our house coffee. Fuels every broadcast.</span>
          <span class="v2coupon">Code <b>PISS</b> for 10% off</span>
        </div>
      </div>
      <a href="https://obdm-shop.fourthwall.com/" target="_blank" rel="noopener" class="v2btn v2btn--dark v2btn--lg">
        Shop All
      </a>
    </section>

    <section class="v2sec reveal" id="latest">
      <h2 class="v2h2">Latest Transmission</h2>
      {latest ? (
        <div class="v2latest">
          <span class="v2latest__no">{latest.episodeNumber ? `EPISODE ${latest.episodeNumber}` : "SPECIAL BROADCAST"}</span>
          <h3 class="v2latest__title">{latest.cleanTitle}</h3>

          {latest.audioUrl ? (
            <div class="v2player" data-player>
              <audio preload="none" data-audio src={latest.audioUrl} />
              <button type="button" class="v2player__play" data-play aria-label="Play latest episode">
                <Icon name="play" size={16} class="player__icon player__icon--play" />
                <Icon name="pause" size={16} class="player__icon player__icon--pause" />
              </button>
              <div class="v2player__body">
                <input class="v2player__seek" type="range" min="0" max="1000" value="0" data-seek aria-label="Seek playback position" />
                <div class="v2player__time">
                  <span data-current>0:00</span>
                  <span data-duration>--:--</span>
                </div>
              </div>
            </div>
          ) : (
            <a href={latest.link} target="_blank" rel="noopener" class="v2btn v2btn--amber v2btn--lg">
              <Icon name="play" size={14} /> Play Latest
            </a>
          )}

          {latest.chapters.length > 0 ? (
            <ol class="v2chapters" data-chapters>
              {latest.chapters.map((ch) =>
                latest.audioUrl ? (
                  <li>
                    <button type="button" class="v2chapter-row" data-seconds={ch.seconds}>
                      <span class="t">{formatTime(ch.seconds)}</span>
                      <span class="d">{ch.label}</span>
                    </button>
                  </li>
                ) : (
                  <li class="v2chapter-row v2chapter-row--static">
                    <span class="t">{formatTime(ch.seconds)}</span>
                    <span class="d">{ch.label}</span>
                  </li>
                ),
              )}
            </ol>
          ) : (
            <p class="v2fallback">{latest.summary}</p>
          )}
        </div>
      ) : (
        <p class="v2fallback">Feed's down for a second — check back shortly, or hit the RSS feed directly.</p>
      )}
    </section>
  </main>

  <footer class="v2foot">
    <div class="wrap">
      <div class="v2foot__grid">
        <div>
          <div class="v2foot__brand">Our Big Dumb Mouth</div>
          <p>A weekly news / conspiracy / comedy podcast. UFOs, Bigfoot &amp; explicit content. If you listen to three episodes, you'll get it.</p>
        </div>
        <div>
          <h4>Connect</h4>
          <a href="https://rumble.com/user/obdm" target="_blank" rel="noopener">Rumble</a>
          <a href="https://www.twitch.tv/obdmpod" target="_blank" rel="noopener">Twitch</a>
          <a href="https://www.youtube.com/@obdmpod" target="_blank" rel="noopener">YouTube</a>
          <a href="https://www.instagram.com/obdmpod/" target="_blank" rel="noopener">Instagram</a>
          <a href="https://x.com/obdmpod" target="_blank" rel="noopener">X</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href="tel:+15134612175">513·461·2175</a>
          <a href="mailto:ourbigdumbmouth@gmail.com">ourbigdumbmouth@gmail.com</a>
          <p>PO Box 708<br />Sunbury, OH 43074</p>
        </div>
      </div>
      <div class="v2foot__big">SHABLAGOO</div>
      <p class="v2foot__copy">© {new Date().getFullYear()} OBDM — Our Big Dumb Mouth</p>
    </div>
  </footer>
</Layout>

<style>
  .concept-flag {
    position: sticky;
    top: 0;
    z-index: 500;
    background: var(--amber);
    color: #0a0a0a;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 9px 16px;
  }

  .concept-flag span {
    font-weight: 700;
  }

  .concept-flag a {
    margin-left: 14px;
    text-decoration: underline;
    font-weight: 700;
  }

  .v2nav {
    position: sticky;
    top: 34px;
    z-index: 400;
    background: #050505;
    border-bottom: 3px solid var(--green);
  }

  .v2nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .v2nav__brand {
    font-family: var(--font-body);
    font-weight: 900;
    font-size: 30px;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .v2nav__right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .v2nav__links {
    display: flex;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .v2nav__links a {
    color: var(--dim);
  }

  .v2nav__links a:hover {
    color: var(--green);
  }

  @media (max-width: 780px) {
    .v2nav__links {
      display: none;
    }
  }

  .v2btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 13px;
    padding: 12px 20px;
    border: 3px solid currentColor;
    border-radius: 0;
    transition: none;
  }

  .v2btn--green {
    color: var(--green);
  }
  .v2btn--green:hover {
    background: var(--green);
    color: #050505;
  }

  .v2btn--amber {
    color: var(--amber);
  }
  .v2btn--amber:hover {
    background: var(--amber);
    color: #050505;
  }

  .v2btn--dark {
    color: #0a0a0a;
    background: var(--bone);
    border-color: #0a0a0a;
  }
  .v2btn--dark:hover {
    background: #0a0a0a;
    color: var(--bone);
  }

  .v2btn--white {
    color: var(--bone);
    border-color: var(--bone);
  }
  .v2btn--white:hover {
    background: var(--bone);
    color: #0a0a0a;
  }

  /* dim/unlit by default, only lights up + blinks when the schedule check
     in Layout.astro confirms the show is actually live */
  .v2btn .live-dot {
    background: var(--dim);
    box-shadow: none;
    animation: none;
  }

  .v2btn.dropdown__toggle--live .live-dot {
    background: var(--red);
    box-shadow: 0 0 8px var(--red);
    animation: blink 1.4s steps(1) infinite;
  }

  .v2btn--lg {
    font-size: 15px;
    padding: 16px 28px;
  }

  .marquee {
    background: var(--green);
    color: #050505;
    overflow: hidden;
    border-bottom: 3px solid #050505;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    gap: 40px;
    padding: 10px 0;
    animation: marquee-scroll 22s linear infinite;
  }

  .marquee__track span {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .marquee__track span::after {
    content: "//";
    margin-left: 40px;
    opacity: 0.5;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .v2hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 88vh;
    background: #050505;
    overflow: hidden;
  }

  .v2hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 12%;
    filter: saturate(1.1) contrast(1.05);
  }

  /* multi-layer gradients must use background-image, not the background
     shorthand — the shorthand rendered opaque on this project before */
  .v2hero__scrim {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(5, 5, 5, 0.94) 0%, rgba(5, 5, 5, 0.86) 30%, rgba(5, 5, 5, 0.45) 55%, rgba(5, 5, 5, 0) 78%),
      linear-gradient(to top, rgba(5, 5, 5, 0.6) 0%, rgba(5, 5, 5, 0) 30%);
    pointer-events: none;
  }

  .v2hero__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 720px;
    padding: 96px clamp(24px, 5vw, 72px);
  }

  .v2tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--dim);
    margin-bottom: 20px;
  }

  .v2hero h1 {
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(72px, 11vw, 160px);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--bone);
  }

  .v2hero__full {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.3em;
    color: var(--dim);
    margin: 14px 0 26px;
  }

  .v2hero__kicker {
    font-family: var(--font-mono);
    color: var(--ufo);
    font-size: 15px;
    margin-bottom: 16px;
  }

  .v2hero__lead {
    font-size: 16px;
    line-height: 1.6;
    max-width: 52ch;
    color: #cfd6dd;
    margin-bottom: 30px;
  }

  .v2hero__cta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .v2hero__alt {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
  }

  .v2hero__alt a {
    color: var(--dim);
    text-decoration: underline;
  }

  .v2hero__flicker {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    mix-blend-mode: overlay;
    animation: v2hero-flicker 7s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes v2hero-flicker {
    0%,
    91%,
    100% {
      opacity: 0;
    }
    92% {
      opacity: 0.1;
    }
    92.6% {
      opacity: 0.02;
    }
    93.2% {
      opacity: 0.08;
    }
    94% {
      opacity: 0;
    }
  }

  .v2hero__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0) 0 2px, rgba(0, 0, 0, 0.18) 2px 3px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .v2hero {
      min-height: 76vh;
    }

    .v2hero__video {
      object-position: 68% 12%;
    }

    /* narrow screens: darken the whole frame so copy stays readable */
    .v2hero__scrim {
      background-image:
        linear-gradient(to right, rgba(5, 5, 5, 0.88) 0%, rgba(5, 5, 5, 0.72) 100%),
        linear-gradient(to top, rgba(5, 5, 5, 0.6) 0%, rgba(5, 5, 5, 0) 40%);
    }

    .v2hero__text {
      padding: 64px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2hero__flicker {
      display: none;
    }
  }

  .v2social {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    background: #050505;
    border-bottom: 3px solid var(--line);
  }

  .v2social a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 24px;
    border-right: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  .v2social a:hover {
    background: var(--green);
    color: #050505;
  }

  main {
    background: #050505;
  }

  .v2sec {
    padding: 88px clamp(20px, 5vw, 72px);
    border-bottom: 3px solid var(--line);
  }

  .v2sec--violet {
    background: var(--ufo);
  }

  .v2sec--amber {
    background: var(--amber);
  }

  .v2h2 {
    font-family: var(--font-body);
    font-weight: 900;
    font-size: clamp(40px, 6vw, 76px);
