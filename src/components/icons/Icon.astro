---
export type IconName =
  | "twitch"
  | "rumble"
  | "youtube"
  | "instagram"
  | "x"
  | "spotify"
  | "podcast"
  | "odysee"
  | "rss"
  | "shirt"
  | "tumbler"
  | "phone"
  | "mail"
  | "mailbox"
  | "chevron-down"
  | "play"
  | "pause"
  | "patreon"
  | "star"
  | "coin"
  | "signal"
  | "arrow-right";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "twitch" && (
      <>
        <path d="M5 3.5 3.5 7v12h5V21l3-1.5h3.5L19.5 15V3.5Z" />
        <path d="M11 8v4.5M15.5 8v4.5" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "rumble" && (
      <>
        <path d="M8 5.5v13l5-3.2a2.6 2.6 0 0 0 0-6.6Z" fill="currentColor" stroke="none" />
        <path d="M16.5 9.8a2.6 2.6 0 0 1 0 4.4" />
      </>
    )
  }
  {
    name === "youtube" && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="4" />
        <path d="M10.5 9.2v5.6l5-2.8Z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "instagram" && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="16.8" cy="7.2" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "x" && (
      <>
        <path d="M4.5 4.5 19.5 19.5" />
        <path d="M19.5 4.5 4.5 19.5" />
      </>
    )
  }
  {
    name === "spotify" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M7.3 10.2c3-.9 6.4-.6 9 .9M7.8 13.1c2.5-.7 5.2-.5 7.4.7M8.3 15.8c2-.5 4.1-.4 5.8.5" />
      </>
    )
  }
  {
    name === "podcast" && (
      <>
        <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
        <path d="M9 9.2a4.2 4.2 0 0 1 6 0M6.8 7a7.4 7.4 0 0 1 10.4 0" />
        <path d="M9 14.8a4.2 4.2 0 0 0 6 0M6.8 17a7.4 7.4 0 0 0 10.4 0" />
      </>
    )
  }
  {
    name === "odysee" && (
      <>
        <path d="M12 3.5 20 8v8l-8 4.5L4 16V8Z" />
        <path d="M10 9.5v5l4.3-2.5Z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "rss" && (
      <>
        <circle cx="5.3" cy="18.7" r="1.6" fill="currentColor" stroke="none" />
        <path d="M4 11.5a8.5 8.5 0 0 1 8.5 8.5" />
        <path d="M4 5.8A14.2 14.2 0 0 1 18.2 20" />
      </>
    )
  }
  {
    name === "shirt" && (
      <path d="M8.5 4 5 6.5 3.5 10l3 1.5V20h11v-8.5l3-1.5L19 6.5 15.5 4a3.5 3.5 0 0 1-7 0Z" />
    )
  }
  {
    name === "tumbler" && (
      <>
        <path d="M8 3.5h8l-.6 4H8.6Z" />
        <path d="M7.4 7.5h9.2l-1.1 11a2 2 0 0 1-2 1.8h-3a2 2 0 0 1-2-1.8Z" />
        <path d="M8.7 11h6.6" />
      </>
    )
  }
  {
    name === "phone" && (
      <path d="M6 3.5h3l1.3 4L8 9.3a11 11 0 0 0 6.7 6.7l1.8-2.3 4 1.3v3a1.7 1.7 0 0 1-1.9 1.7A16.5 16.5 0 0 1 4.3 5.4 1.7 1.7 0 0 1 6 3.5Z" />
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2.5" />
        <path d="M4.5 7 12 12.5 19.5 7" />
      </>
    )
  }
  {
    name === "mailbox" && (
      <>
        <path d="M4 20V10a5 5 0 0 1 10-.5h6V17a3 3 0 0 1-3 3H4Z" />
        <path d="M14 9.5V15" />
        <path d="M2.5 17h4" />
      </>
    )
  }
  {
    name === "chevron-down" && <path d="M5.5 8.5 12 15l6.5-6.5" />
  }
  {
    name === "play" && <path d="M7 5.2v13.6L18.5 12Z" fill="currentColor" stroke="none" />
  }
  {
    name === "pause" && (
      <>
        <path d="M7 5.5h3.2v13H7Z" fill="currentColor" stroke="none" />
        <path d="M13.8 5.5H17v13h-3.2Z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "patreon" && (
      <>
        <circle cx="14.2" cy="9.8" r="6.2" fill="currentColor" stroke="none" />
        <path d="M6.2 4v16" stroke-width="2.4" />
      </>
    )
  }
  {
    name === "star" && (
      <path d="m12 3.5 2.6 5.5 6 .7-4.4 4.1 1.2 5.9L12 16.8l-5.4 2.9 1.2-5.9-4.4-4.1 6-.7Z" />
    )
  }
  {
    name === "coin" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5v9M9.7 9.7c0-1 1-1.7 2.3-1.7 1.5 0 2.4.8 2.4 1.8 0 2.4-4.7 1.1-4.7 3.5 0 1 1 1.8 2.4 1.8 1.3 0 2.3-.6 2.3-1.7" />
      </>
    )
  }
  {
    name === "signal" && (
      <path d="M4 18v-3M9 18v-6M14 18V9M19 18V5" />
    )
  }
  {
    name === "arrow-right" && <path d="M4.5 12h14M13 6.5 19.5 12 13 17.5" />
  }
</svg>
