---
import { Image } from "astro:assets";
import Icon from "./icons/Icon.astro";
import partnerLogo from "../assets/partner-foxnsons-logo.jpg";
import goblinTee from "../assets/merch-goblin-tee.webp";
---

<section class="sec reveal" id="merch">
  <div class="wrap">
    <div class="sec__head">
      <h2>OBDM Shop</h2>
      <a href="https://obdm-shop.fourthwall.com/" target="_blank" rel="noopener" class="btn btn--amber-solid merch-cta">
        Shop All
      </a>
    </div>

    <div class="merch-grid">
      <div class="merch-card">
        <div class="merch-card__art merch-card__art--photo">
          <Image src={goblinTee} alt="The Goblin OBDM tee — dark grey cotton shirt with a phosphor-green goblin print" width={480} height={640} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__name">The Goblin</span>
          <span class="merch-card__desc">Dark grey cotton, phosphor-green front print</span>
          <span class="merch-card__price">
            $28 <span class="fpo-tag">Price TBD</span>
          </span>
        </div>
      </div>

      <div class="merch-card">
        <div class="merch-card__art">
          <Icon name="tumbler" size={52} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__name">OBDM Tumbler</span>
          <span class="merch-card__desc">Stainless steel, keeps coffee hot and smoothies cold</span>
          <span class="merch-card__price">
            $32 <span class="fpo-tag">FPO</span>
          </span>
        </div>
      </div>

      <div class="merch-card merch-card--partner">
        <span class="merch-card__eyebrow">◆ Partner Spot · rentable</span>
        <div class="partner-plaque">
          <Image src={partnerLogo} alt="Fox N' Sons Coffee" width={420} height={102} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__desc">Our house coffee. Fuels every broadcast.</span>
          <span class="coupon">
            Code <b>PISS</b> for 10% off
          </span>
        </div>
        <a href="mailto:ourbigdumbmouth@gmail.com?subject=Partner%20with%20OBDM" class="merch-card__partner-cta">
          This slot rotates — want it next?
          <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>

    <p class="fpo-note">// Tumbler has no product yet — mockup or real photo before launch. Goblin photo is real; price to confirm. A real coffee-bag shot would upgrade the partner slot too.</p>
  </div>
</section>

<style>
  .merch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .merch-card {
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition:
      border-color 0.18s var(--ease-signal),
      transform 0.18s var(--ease-signal),
      box-shadow 0.18s var(--ease-signal);
  }

  .merch-card:hover {
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px var(--green), 0 14px 30px -18px var(--green);
  }

  .merch-card__art {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 4;
    margin-bottom: 14px;
    border-radius: 4px;
    color: var(--green);
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(70, 245, 160, 0.12), transparent 65%),
      var(--void-2);
  }

  .merch-card__art--photo {
    padding: 0;
    overflow: hidden;
  }

  .merch-card__art--photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .merch-card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .merch-card__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .merch-card__desc {
    color: var(--dim);
    font-size: 13.5px;
  }

  .merch-card__price {
    font-family: var(--font-mono);
    color: var(--bone);
    font-size: 14px;
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .fpo-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--dim);
    border: 1px dashed var(--line);
    border-radius: 20px;
    padding: 2px 7px;
  }

  /* --- partner card: distinct treatment, sparing violet accent --- */
  .merch-card--partner {
    background: linear-gradient(155deg, rgba(176, 107, 250, 0.07), var(--panel));
  }

  .merch-card--partner:hover {
    border-color: var(--ufo);
    box-shadow: 0 0 0 1px var(--ufo), 0 14px 30px -18px var(--ufo);
  }

  .merch-card__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ufo);
    margin-bottom: 14px;
  }

  .partner-plaque {
    background: #f4efe6;
    border-radius: 4px;
    aspect-ratio: 3 / 4;
    padding: 24px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .partner-plaque :global(img) {
    width: 100%;
    height: auto;
  }

  .coupon {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--amber);
    margin-top: 8px;
  }

  .coupon b {
    letter-spacing: 0.04em;
  }

  .merch-card__partner-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    transition: color 0.18s var(--ease-signal);
  }

  .merch-card__partner-cta:hover,
  .merch-card__partner-cta:focus-visible {
    color: var(--ufo);
  }

  .fpo-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--green-dim);
    letter-spacing: 0.03em;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .merch-grid {
      grid-template-columns: 1fr;
    }

    .merch-card__art,
    .partner-plaque {
      aspect-ratio: 4 / 3;
    }
  }
</style>
