---
import { Image } from "astro:assets";
import Icon from "./icons/Icon.astro";
import partnerShot from "../assets/partner-foxnsons.webp";
import tippyTee from "../assets/merch-tippy-tee-fw.webp";
import tippyMug from "../assets/merch-tippy-mug-black.webp";
import coolantBottle from "../assets/merch-coolant-black.webp";
---

<section class="sec reveal" id="merch">
  <div class="wrap">
    <div class="sec__head">
      <h2>OBDM Shop</h2>
      <a href="https://obdm-shop.fourthwall.com/" target="_blank" rel="noopener" class="btn btn--amber-solid merch-cta">
        Shop All
      </a>
    </div>

    <div class="merch-grid">
      <a class="merch-card" href="https://obdm-shop.fourthwall.com/products/tippy-top-supersoft-tee" target="_blank" rel="noopener">
        <div class="merch-card__art merch-card__art--photo">
          <Image src={tippyTee} alt="Tippy Top Supersoft Tee — black shirt with the TIPPY TOP flying-saucer badge on the chest" width={480} height={640} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__name">Tippy Top Supersoft Tee</span>
          <span class="merch-card__desc">Bella+Canvas 3001 &middot; soft, lightweight 4.2oz cotton</span>
          <span class="merch-card__price">$26</span>
        </div>
      </a>

      <a class="merch-card" href="https://obdm-shop.fourthwall.com/products/tippy-top-mug" target="_blank" rel="noopener">
        <div class="merch-card__art merch-card__art--photo">
          <Image src={tippyMug} alt="Tippy Top Mug — black glossy ceramic with the TIPPY TOP flying-saucer badge" width={480} height={640} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__name">Tippy Top Mug</span>
          <span class="merch-card__desc">Black glossy ceramic &middot; 11oz and 15oz</span>
          <span class="merch-card__price">from $13.95</span>
        </div>
      </a>

      <a class="merch-card" href="https://obdm-shop.fourthwall.com/products/data-center-coolant-black" target="_blank" rel="noopener">
        <div class="merch-card__art merch-card__art--photo">
          <Image src={coolantBottle} alt="Data Center Coolant bottle — black insulated stainless steel with the DATA CENTER COOLANT lockup" width={480} height={640} />
        </div>
        <div class="merch-card__body">
          <span class="merch-card__name">Data Center Coolant</span>
          <span class="merch-card__desc">17oz insulated stainless &middot; hot or cold for 6 hours</span>
          <span class="merch-card__price">$25</span>
        </div>
      </a>

      <div class="merch-card merch-card--partner">
        <a
          class="merch-card__art merch-card__art--photo partner-shot"
          href="https://www.foxnsons.com/shop"
          target="_blank"
          rel="noopener"
        >
          <Image src={partnerShot} alt="Fox N' Sons Coffee — a bag of Costa Rican Natural whole bean beside a branded stoneware mug" width={480} height={640} />
        </a>
        <div class="merch-card__body">
          <span class="merch-card__desc">Our house coffee. Fuels every broadcast.</span>
          <span class="coupon">
            Code <b>PISS</b> &mdash; 15% off orders over $30
          </span>
        </div>
        <a href="mailto:ourbigdumbmouth@gmail.com?subject=Partner%20with%20OBDM" class="merch-card__partner-cta">
          Support our supporters!
          <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .merch-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .merch-card {
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition:
      border-color 0.18s var(--ease-signal),
      transform 0.18s var(--ease-signal),
      box-shadow 0.18s var(--ease-signal);
  }

  a.merch-card {
    text-decoration: none;
    color: inherit;
  }

  .merch-card:hover {
    border-color: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px var(--green), 0 14px 30px -18px var(--green);
  }

  .merch-card__art {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 4;
    margin-bottom: 14px;
    border-radius: 4px;
    color: var(--green);
    background:
      radial-gradient(120% 140% at 50% 0%, rgba(70, 245, 160, 0.12), transparent 65%),
      var(--void-2);
  }

  .merch-card__art--photo {
    padding: 0;
    overflow: hidden;
  }

  .merch-card__art--photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .merch-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .merch-card__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .merch-card__desc {
    color: var(--dim);
    font-size: 13.5px;
  }

  .merch-card__price {
    font-family: var(--font-mono);
    color: var(--bone);
    font-size: 14px;
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

    /* --- partner card: distinct treatment, sparing violet accent --- */
  .merch-card--partner {
    background: linear-gradient(155deg, rgba(176, 107, 250, 0.07), var(--panel));
  }

  .merch-card--partner:hover {
    border-color: var(--ufo);
    box-shadow: 0 0 0 1px var(--ufo), 0 14px 30px -18px var(--ufo);
  }

  .merch-card__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ufo);
    margin-bottom: 14px;
  }



  .coupon {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--amber);
    margin-top: 8px;
  }

  .coupon b {
    letter-spacing: 0.04em;
  }

  .merch-card__partner-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    transition: color 0.18s var(--ease-signal);
  }

  .merch-card__partner-cta:hover,
  .merch-card__partner-cta:focus-visible {
    color: var(--ufo);
  }

  @media (max-width: 1180px) {
    .merch-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .merch-grid {
      grid-template-columns: 1fr;
    }

    .merch-card__art {
      aspect-ratio: 4 / 3;
    }
  }
</style>
