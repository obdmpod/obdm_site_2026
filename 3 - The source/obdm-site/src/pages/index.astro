---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SocialTray from "../components/SocialTray.astro";
import LiveSchedule from "../components/LiveSchedule.astro";
import JoinSignal from "../components/JoinSignal.astro";
import FeaturedMerch from "../components/FeaturedMerch.astro";
import LatestTransmission from "../components/LatestTransmission.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getLatestEpisode } from "../lib/rss";

let latest = null;
try {
  latest = await getLatestEpisode();
} catch (err) {
  console.error("[obdm] Failed to fetch RSS feed at build time:", err);
}

const title = "OBDM — Our Big Dumb Mouth";
const description =
  "OBDM is a live podcast and talk show hosted by MidNight Mike, Joe, and Cretched. We try to have a laugh or two while covering UFOs, Bigfoot, conspiracies, the paranormal, ancient civilizations, current events, and more. Catch the show live most Wednesdays at 7 Eastern and Saturdays at 10:30 Eastern.";
---

<Layout title={title} description={description} episode={latest}>
  <Nav />
  <Hero />
  <SocialTray />
  <main>
    <LiveSchedule />
    <JoinSignal />
    <FeaturedMerch />
    <LatestTransmission episode={latest} />
  </main>
  <SiteFooter />
</Layout>
